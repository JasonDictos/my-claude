[0.000618, "o", "\u001b[?25l\u001b[38;5;114m\u001b[1;5H \u001b[39m\u001b[38;5;238m\u001b[3C worker ──────────────────────────────────────────────────────────────────────────────────────────────\u001b[1;1H─\u001b[38;5;114m┬──\u001b[C┬\u001b[38;5;238m──\u001b[m\u000f\r\n \u001b[Cnni\u001b[C\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[Cng \u001b[C  Still no end-to-end run against staging; all tests used the fake server.\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[C   \u001b[C\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[C  \u001b[2m~\u001b[m\u000f\u001b[C  Still open: the deploy manifest pins the old image tag. Want me to bump it\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[2m\u001b[C/sr\u001b[m\u000f\u001b[C  in this PR or leave it for the release?\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[2m\u001b[Cc/a\u001b[m\u000f\u001b[C\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[2m\u001b[Cpi\u001b[m\u000f \u001b[C  \u001b[2m~/src/worker\u001b[m\u000f\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[C   \u001b[C\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[C❯  \u001b[C❯\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[C   \u001b[C\u001b[K\u001b[2G\u001b[38;5;114m│\u001b[3C│\u001b[m\u000f\r\n \u001b[38;5;238m\u001b[3C \u001b[39m\u001b[38;5;238mw\u001b[39m\u001b[38;5;238meb ─────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[12;2H\u001b[38;5;114m├\u001b[38;5;238m──\u001b[m\u000f\r\n \u001b[C  I'm holding the push until api confirms the v2 error shape.\u001b[K\u001b[2G\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C\u001b[K\b\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C✻ 2 messages hidden (/focus to show)\u001b[K\u001b[2G\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C\u001b[K\b\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C❯ Move that fallback into a flag so we can turn it off per environment\u001b[K\u001b[2G\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C\u001b[K\b\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C● Moved. The fallback is now behind API_V1_FALLBACK (default on), read once at\u001b[K\u001b[2G\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C  startup, and the test covers both settings. Pushed commit 9c1d0e4.\u001b[K\u001b[2G\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C\u001b[K\b\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C  \u001b[2m~/src/web\u001b[m\u000f\u001b[K\u001b[2G\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C\u001b[K\b\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C❯\u001b[K\u001b[2G\u001b[38;5;238m│\u001b[m\u000f\r\n \u001b[C\u001b[K\b\u001b[38;5;238m│\u001b[m\u000f\u001b[38;5;232m\u001b[48;5;114m\u001b[1m\r\n api-overhaul \u001b[m\u000f\u001b[38;5;250m\u001b[48;5;236m \u001b[1mapi\u001b[m\u000f\u001b[38;5;250m\u001b[48;5;236m★  web  worker                            \u001b[38;5;245mprefix+h shell · prefix+Tab next · prefix+d menu \u001b[38;5;114m█\u001b[m\u000f\u001b[34h\u001b[?25h\u001b[11;3H"]
