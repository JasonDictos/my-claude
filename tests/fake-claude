#!/usr/bin/env bash
# Stand-in for claude in tests: record argv, then idle like a session would.
echo "$PWD $*" >> "${FAKE_CLAUDE_LOG:?}"
# Look alive for demos: a canned transcript if one exists for this repo, then a prompt line.
say="${FAKE_CLAUDE_SAY:-}/$(basename "$PWD").txt"
[[ -n "${FAKE_CLAUDE_SAY:-}" && -f "$say" ]] && { printf "\n"; cat "$say"; }
printf "\n  \033[2m%s\033[0m\n\n❯ \n" "${PWD/#$HOME/\~}"
# Stay a bash process (not an exec'd sleep) so liveness can spot the stub by its path.
while :; do sleep 3600; done
