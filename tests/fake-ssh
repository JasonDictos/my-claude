# Stand-in for ssh in tests: the "other machine" is this one. FAKE_SSH_GATE: run that as
# sshd runs an allowed key's forced command, with what was asked in SSH_ORIGINAL_COMMAND.
while [ $# -gt 0 ]; do
  case "$1" in
    -o|-p|-i|-F|-J) shift 2;;
    -*) shift;;
    *) break;;
  esac
done
dest=$1; shift
echo "$dest: $*" >> "${FAKE_SSH_LOG:-/dev/null}"
# the test ends this connection by pid, never by looking for a command line
case "$*" in *"_gui --stdio"*) [ -n "${FAKE_SSH_PIDFILE:-}" ] && echo $$ > "$FAKE_SSH_PIDFILE";; esac
if [ -n "${FAKE_SSH_GATE:-}" ]; then SSH_ORIGINAL_COMMAND="$*" exec $FAKE_SSH_GATE; fi
exec sh -c "$*"
